+        size_usd = 0.0
+    if size_usd <= 0:
+        print(f"[!] Direct buy skipped for {symbol}: non-positive size")
+        return False
+
+    receipt = submit_direct_market_order(symbol, size_usd, "buy")
+    ok = bool(receipt.get("ok", False))
