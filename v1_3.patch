+CREATE TABLE IF NOT EXISTS component_health (
+    component TEXT PRIMARY KEY,
+    last_attempt_at TEXT,
+    last_healthy_at TEXT,
+    status TEXT NOT NULL,                   -- 'healthy' | 'degraded' | 'idle'
+    detail TEXT
+);
