[Unit]
Description=M.A.C.E. Political & Whale Trade Ingestion Scout
After=network-online.target

[Service]
Type=oneshot
User=fedora
WorkingDirectory=/home/fedora/MACE
ExecStart=/home/fedora/mace_env/bin/python /home/fedora/MACE/equities/swarm/whales_scout.py
EnvironmentFile=/home/fedora/MACE/config/mace.env
StandardOutput=journal
StandardError=journal
