[Unit]
Description=M.A.C.E. High-Frequency HWM & Dynamic Volatility Stop Loss Updater
After=network.target

[Service]
Type=simple
User=fedora
WorkingDirectory=/home/fedora/MACE
EnvironmentFile=/home/fedora/MACE/config/mace.env
ExecStart=/home/fedora/mace_env/bin/python -u /home/fedora/MACE/hwm_stop_updater.py --daemon --interval 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
